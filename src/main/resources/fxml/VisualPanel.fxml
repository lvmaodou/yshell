<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.lang.*?>
<VBox xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.yshell.controller.VisualPanelController">
    <styleClass>
        <String fx:value="visual-panel"/>
    </styleClass>
    <HBox>
        <styleClass>
            <String fx:value="visual-tab-bar"/>
        </styleClass>
        <Label fx:id="tabFiles" text="文件">
            <styleClass>
                <String fx:value="label-tab"/>
                <String fx:value="visual-tab"/>
                <String fx:value="active"/>
            </styleClass>
        </Label>
        <Label fx:id="tabDocker" text="docker">
            <styleClass>
                <String fx:value="label-tab"/>
                <String fx:value="visual-tab"/>
            </styleClass>
        </Label>
        <Label fx:id="tabK8s" text="k8s">
            <styleClass>
                <String fx:value="label-tab"/>
                <String fx:value="visual-tab"/>
            </styleClass>
        </Label>
        <Label fx:id="tabAi" text="AI助手">
            <styleClass>
                <String fx:value="label-tab"/>
                <String fx:value="visual-tab"/>
            </styleClass>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnTerminalVisibility" onAction="#toggleTerminalVisibility">
            <styleClass>
                <String fx:value="button-icon-mini"/>
                <String fx:value="visual-terminal-toggle"/>
            </styleClass>
            <tooltip>
                <Tooltip text="终端显示" showDelay="200ms"/>
            </tooltip>
            <graphic>
                <FontIcon fx:id="terminalVisibilityIcon" iconLiteral="fas-eye-slash"/>
            </graphic>
        </Button>
    </HBox>

    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
        <styleClass>
            <String fx:value="content-area"/>
        </styleClass>
        <fx:include fx:id="filesView" source="FilesView.fxml"/>
        <fx:include fx:id="dockerView" source="DockerView.fxml" managed="false" visible="false"/>
        <fx:include fx:id="k8sView" source="K8sView.fxml" managed="false" visible="false"/>
        <fx:include fx:id="aiView" source="AiView.fxml" managed="false" visible="false"/>
    </StackPane>
</VBox>
