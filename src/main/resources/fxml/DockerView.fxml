<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.*?>
<VBox xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.yshell.controller.DockerViewController"
      stylesheets="@../css/docker-view.css">
    <styleClass>
        <String fx:value="docker-view"/>
    </styleClass>

    <HBox styleClass="docker-layout" VBox.vgrow="ALWAYS">
        <VBox styleClass="docker-sidebar">
            <VBox styleClass="docker-nav" VBox.vgrow="ALWAYS">
                <Button fx:id="navContainers" styleClass="nav-button">
                    <graphic>
                        <HBox styleClass="nav-button-content">
                            <Label text="容器" styleClass="nav-label"/>
                            <Label fx:id="lblContainersCount" text="0">
                                <styleClass>
                                    <String fx:value="nav-count"/>
                                    <String fx:value="count-containers"/>
                                </styleClass>
                            </Label>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="navImages" styleClass="nav-button">
                    <graphic>
                        <HBox styleClass="nav-button-content">
                            <Label text="镜像" styleClass="nav-label"/>
                            <Label fx:id="lblImagesCount" text="0">
                                <styleClass>
                                    <String fx:value="nav-count"/>
                                    <String fx:value="count-images"/>
                                </styleClass>
                            </Label>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="navNetworks" styleClass="nav-button">
                    <graphic>
                        <HBox styleClass="nav-button-content">
                            <Label text="网络" styleClass="nav-label"/>
                            <Label fx:id="lblNetworksCount" text="0">
                                <styleClass>
                                    <String fx:value="nav-count"/>
                                    <String fx:value="count-networks"/>
                                </styleClass>
                            </Label>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="navVolumes" styleClass="nav-button">
                    <graphic>
                        <HBox styleClass="nav-button-content">
                            <Label text="存储卷" styleClass="nav-label"/>
                            <Label fx:id="lblVolumesCount" text="0">
                                <styleClass>
                                    <String fx:value="nav-count"/>
                                    <String fx:value="count-volumes"/>
                                </styleClass>
                            </Label>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="navConfig" styleClass="nav-button">
                    <graphic>
                        <HBox styleClass="nav-button-content">
                            <Label text="配置文件" styleClass="nav-label"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <VBox styleClass="docker-side-status">
                <HBox styleClass="status-row">
                    <Label text="Docker"/>
                    <Label fx:id="lblDockerVersion" text="-" styleClass="status-value"/>
                </HBox>
                <HBox styleClass="status-row">
                    <Label text="API"/>
                    <Label fx:id="lblApiVersion" text="-" styleClass="status-value"/>
                </HBox>
                <Label fx:id="lblDockerStatus" text="未连接" styleClass="status-message"/>
            </VBox>
        </VBox>

        <VBox styleClass="docker-content" HBox.hgrow="ALWAYS">
            <HBox styleClass="docker-toolbar">
                <HBox fx:id="toolbarActions" styleClass="toolbar-actions"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchBox" promptText="搜索当前列表" styleClass="search-box"/>
            </HBox>

            <StackPane fx:id="contentStack" VBox.vgrow="ALWAYS">
                <TableView fx:id="dockerTable" styleClass="docker-table">
                    <columns>
                        <TableColumn fx:id="colSelect" prefWidth="42" sortable="false" resizable="false"/>
                        <TableColumn fx:id="colName" text="名称" prefWidth="220"/>
                        <TableColumn fx:id="colId" text="ID" prefWidth="130"/>
                        <TableColumn fx:id="colStatus" text="状态" prefWidth="160"/>
                        <TableColumn fx:id="colDetail" text="详情" prefWidth="260"/>
                        <TableColumn fx:id="colExtra" text="附加信息" prefWidth="180"/>
                    </columns>
                </TableView>

                <VBox fx:id="configPane" styleClass="config-pane" managed="false" visible="false">
                    <HBox styleClass="config-header">
                        <Label text="/etc/docker/daemon.json" styleClass="config-path"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="保存后需重启 Docker 生效" styleClass="config-hint"/>
                    </HBox>
                    <TextArea fx:id="configEditor" promptText="Docker 配置文件内容" styleClass="config-editor"
                              VBox.vgrow="ALWAYS"/>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>
</VBox>
