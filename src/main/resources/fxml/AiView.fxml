<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.lang.String?>
<VBox xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.yshell.controller.AiViewController"
      stylesheets="@../css/ai-view.css">
    <styleClass>
        <String fx:value="ai-view"/>
    </styleClass>

    <BorderPane VBox.vgrow="ALWAYS">
        <left>
            <VBox styleClass="ai-sidebar">
                <HBox styleClass="ai-sidebar-header">
                    <Label text="历史问答" styleClass="ai-sidebar-title"/>
                </HBox>
                <ListView fx:id="historyList" VBox.vgrow="ALWAYS" styleClass="ai-history-list"/>
            </VBox>
        </left>

        <center>
            <BorderPane styleClass="ai-main">
                <top>
                    <HBox styleClass="ai-toolbar">
                        <Button text="新开话题" onAction="#newTopic" styleClass="button-cancel">
                            <graphic>
                                <FontIcon iconLiteral="fas-plus" iconSize="12"/>
                            </graphic>
                        </Button>
                        <Button text="配置" onAction="#openAiSettings" styleClass="button-cancel">
                            <graphic>
                                <FontIcon iconLiteral="fas-cog" iconSize="12"/>
                            </graphic>
                        </Button>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statusLabel" text="就绪" styleClass="ai-status"/>
                    </HBox>
                </top>

                <center>
                    <ScrollPane fx:id="chatScroll" fitToWidth="true" styleClass="chat-scroll">
                        <VBox fx:id="chatMessages" styleClass="chat-messages"/>
                    </ScrollPane>
                </center>

                <bottom>
                    <VBox styleClass="input-area">
                        <FlowPane fx:id="attachmentBar" styleClass="attachment-bar" visible="false" managed="false"/>
                        <TextArea fx:id="inputArea"
                                  promptText="输入 Linux、Docker、K8s 命令问题；可直接粘贴图片；选中内容Ctrl+c复制，Ctrl+Enter终端执行"
                                  wrapText="true" styleClass="input-textarea"/>
                        <HBox styleClass="input-footer">
                            <ComboBox fx:id="aiModelSelector" promptText="选择模型" styleClass="model-selector"/>
                            <Button fx:id="btnUploadImage" text="上传图片" onAction="#uploadImage"
                                    styleClass="button-cancel" style="-fx-font-size: 11px">
                                <graphic>
                                    <FontIcon iconLiteral="fas-image" iconSize="11"/>
                                </graphic>
                            </Button>
                            <Label text="思考" styleClass="input-option-label"/>
                            <ComboBox fx:id="thinkingModeSelector" promptText="强度"
                                      styleClass="thinking-selector"/>
                            <Label text="流式输出" styleClass="input-option-label"/>
                            <CheckBox fx:id="streamToggle" styleClass="input-check"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Enter发送 Shift+Enter换行" styleClass="input-hint"/>
                            <Button fx:id="btnSend" text="发送" onAction="#sendMessage">
                                <styleClass>
                                    <String fx:value="send-btn"/>
                                    <String fx:value="button-primary"/>
                                </styleClass>
                                <graphic>
                                    <FontIcon iconLiteral="fas-paper-plane" iconSize="11"/>
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </bottom>
            </BorderPane>
        </center>
    </BorderPane>
</VBox>
