<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.lang.*?>
<VBox fx:id="root" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.yshell.controller.TransferQueueController">
    <styleClass>
        <String fx:value="transfer-window"/>
    </styleClass>
    <HBox>
        <styleClass>
            <String fx:value="transfer-title-bar"/>
        </styleClass>
        <Label text="传输队列">
            <styleClass>
                <String fx:value="transfer-title-label"/>
            </styleClass>
        </Label>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnMinimize">
            <styleClass>
                <String fx:value="button-window"/>
                <String fx:value="window-btn"/>
            </styleClass>
            <graphic>
                <FontIcon iconLiteral="fas-minus"/>
            </graphic>
        </Button>
        <Button fx:id="btnMaximize">
            <styleClass>
                <String fx:value="button-window"/>
                <String fx:value="window-btn"/>
            </styleClass>
            <graphic>
                <FontIcon iconLiteral="far-square"/>
            </graphic>
        </Button>
        <Button fx:id="btnClose">
            <styleClass>
                <String fx:value="button-close"/>
                <String fx:value="window-btn-close"/>
            </styleClass>
            <graphic>
                <FontIcon iconLiteral="fas-times"/>
            </graphic>
        </Button>
    </HBox>

    <BorderPane VBox.vgrow="ALWAYS">
        <top>
            <HBox>
                <styleClass>
                    <String fx:value="transfer-root-bar"/>
                </styleClass>
                <Label text="下载目录"/>
                <TextField fx:id="downloadDirectoryField" editable="false" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnChooseDirectory" text="选择"/>
                <Button fx:id="btnOpenDirectory" text="打开"/>
                <Button fx:id="btnResumeAll" text="全部开始"/>
                <Button fx:id="btnPauseAll" text="全部暂停"/>
                <Button fx:id="btnClearTasks" text="清空列表"/>
            </HBox>
        </top>
        <center>
            <TabPane fx:id="transferTabs" styleClass="transfer-tabs">
                <Tab fx:id="downloadTab" text="下载" closable="false">
                    <TableView fx:id="downloadTable" styleClass="transfer-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="downloadNameColumn" text="名称" minWidth="160"/>
                            <TableColumn fx:id="downloadPathColumn" text="路径" minWidth="280"/>
                            <TableColumn fx:id="downloadProgressColumn" text="进度" minWidth="120"/>
                            <TableColumn fx:id="downloadSizeColumn" text="大小" minWidth="130"/>
                            <TableColumn fx:id="downloadSpeedColumn" text="速度" minWidth="90"/>
                            <TableColumn fx:id="downloadStatusColumn" text="状态" minWidth="140"/>
                            <TableColumn fx:id="downloadActionColumn" text="操作" minWidth="240"/>
                        </columns>
                    </TableView>
                </Tab>
                <Tab fx:id="uploadTab" text="上传" closable="false">
                    <TableView fx:id="uploadTable" styleClass="transfer-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="uploadNameColumn" text="名称" minWidth="160"/>
                            <TableColumn fx:id="uploadPathColumn" text="路径" minWidth="280"/>
                            <TableColumn fx:id="uploadProgressColumn" text="进度" minWidth="120"/>
                            <TableColumn fx:id="uploadSizeColumn" text="大小" minWidth="130"/>
                            <TableColumn fx:id="uploadSpeedColumn" text="速度" minWidth="90"/>
                            <TableColumn fx:id="uploadStatusColumn" text="状态" minWidth="140"/>
                            <TableColumn fx:id="uploadActionColumn" text="操作" minWidth="240"/>
                        </columns>
                    </TableView>
                </Tab>
            </TabPane>
        </center>
    </BorderPane>
</VBox>
